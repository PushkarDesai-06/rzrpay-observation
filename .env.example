# ============================================================================
# LLM — any provider, any base URL, any model
# ============================================================================
# The system runs without any of this: with no LLM configured it uses the
# deterministic decider and records every decision as `heuristic_fallback`,
# so a run without a model is never mistaken for a run with one.
#
# anthropic | openai | none. Omit to auto-detect from whichever key is set.
#   anthropic → Anthropic Messages API (Claude, or any proxy speaking it)
#   openai    → any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Anthropic only: low | medium | high | xhigh | max
LLM_EFFORT=medium
LLM_MAX_TOKENS=
# Set false for gateways that reject response_format: json_schema.
# Not usually needed — a 400/422 auto-degrades to json_object anyway.
LLM_JSON_SCHEMA=true
# Extra headers as JSON, e.g. OpenRouter attribution:
# LLM_HEADERS={"HTTP-Referer":"https://example.com","X-Title":"Recovery Agent"}
LLM_HEADERS=

# --- Worked examples (uncomment one) ----------------------------------------
# Anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-opus-5
#
# OpenAI
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
#
# OpenRouter
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=sk-or-...
# LLM_MODEL=anthropic/claude-sonnet-5
#
# Local Ollama
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.3
#
# LiteLLM / company gateway
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://gateway.internal/v1
# LLM_API_KEY=...
# LLM_MODEL=whatever-the-gateway-calls-it

# Provider-specific aliases are also honoured, so an existing key just works:
#   ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL / ANTHROPIC_MODEL / ANTHROPIC_EFFORT
#   OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL

# ============================================================================
# Razorpay (TEST MODE ONLY)
# ============================================================================
# Test-mode credentials never move real money. Used for CREATE_PAYMENT_LINK and
# payment status polling. RETRY_PAYMENT always runs on the simulated provider,
# because Razorpay has no server-initiated re-charge of a failed payment without
# a saved token or an active mandate.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ============================================================================
# Runtime
# ============================================================================
DATABASE_PATH=./data/recovery.db
# system | simulated — simulated lets the demo advance hours in seconds
CLOCK_MODE=simulated
# Fixes every simulated payment outcome, so runs are reproducible.
SIMULATION_SEED=20260830
